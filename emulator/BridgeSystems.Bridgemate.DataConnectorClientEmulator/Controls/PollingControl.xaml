<UserControl x:Class="BridgeSystems.Bridgemate.DataConnectorClientEmulator.Controls.PollingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BridgeSystems.Bridgemate.DataConnectorClientEmulator.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <CheckBox IsChecked="{Binding PollAll}" Content="Poll all"/>

        <TextBlock Style="{StaticResource HeaderTextblockStyle}">
     Polls for all results or only new results after the last accept was sent.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PollResultsCommand}" Content="Poll results"
                 Width="180" ToolTip="{Binding PollResultsCommandDescription}"/>
            <Button Command="{Binding AcceptResultsCommand}" Content="Accept results"
                 HorizontalAlignment="Right" Width="180" ToolTip="{Binding AcceptResultsCommandDescription}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource HeaderTextblockStyle}">
     Polls for all playerdata or only new playerdata after the last accept was sent.
     Always poll for player data before polling for participations.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PollPlayerDataCommand}" Content="Poll playerdata"
                 Width="180" ToolTip="{Binding PollPlayerDataCommandDescription}"/>
            <Button Command="{Binding AcceptPlayerDataCommand}" Content="Accept player data"
                 HorizontalAlignment="Right" Width="180" ToolTip="{Binding AcceptPlayerDataCommandDescription}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource HeaderTextblockStyle}">
     Polls for all participations or only new results after the last accept was sent.
     The participation will always contain the situation for round one.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PollParticipationsCommand}" Content="Poll participations"
                 Width="180" ToolTip="{Binding PollParticipationsCommandDescription}"/>
            <Button Command="{Binding AcceptParticipationsCommand}" Content="Accept participations"
                 HorizontalAlignment="Right" Width="180" ToolTip="{Binding AcceptParticipationsCommandDescription}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource HeaderTextblockStyle}">
        Polls for all handrecords or only new handrecords after the last accept was sent.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PollHandrecordsCommand}" Content="Poll handrecords" Width="180"
                    ToolTip="{Binding PollHandrecordsCommandDescription}"/>
            <Button Command="{Binding AcceptHandrecordsCommand}" Content="Accept handrecords"
                 HorizontalAlignment="Right" Width="180" ToolTip="{Binding AcceptHandrecordsCommandDescription}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource HeaderTextblockStyle}">
        Polls for all td call status updates or only new ones after the last accept was sent.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding PollTdCallsCommand}" Content="Poll td calls" Width="180"
                    ToolTip="{Binding PollTdCallsCommandDescription}"/>
            <Button Command="{Binding AcceptTdCallsCommand}" Content="Accept td calls"
                 HorizontalAlignment="Right" Width="180" ToolTip="{Binding AcceptTdCallsCommandDescription}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
