<Application x:Class="BridgeSystems.Bridgemate.DataConnectorClientEmulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BridgeSystems.Bridgemate.DataConnectorClientEmulator"
             xmlns:fcv="clr-namespace:BridgeSystems.Bridgemate.DataConnectorClientEmulator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <fcv:BoolToVisibilityConverter x:Key="BVP"/>
        <fcv:BoolToOpacityConverter x:Key="BOC"/>
        <fcv:ErrorTypeToColorConverter x:Key="ECC"/>
        <fcv:NotConverter x:Key="Not"/>
        <fcv:ScoringTypeConverter x:Key="ScoringTypeConverter"/>
        <fcv:GameTypeConverter x:Key="GameTypeConverter"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="BorderBrush" Value="DarkSlateGray"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6,1,2,2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MaxWidth" Value="180"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2,4,4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin"  Value="2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin"  Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="2,4,2,1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Image">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabellikeTextblockStyle">
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="LightSlateGray" Opacity=".2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderTextblockStyle">
            <Setter Property="Margin" Value="2,6,2,1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="LightSlateGray" Opacity=".1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
