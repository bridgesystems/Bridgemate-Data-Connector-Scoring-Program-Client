<UserControl x:Class="BridgeSystems.Bridgemate.DataConnectorClientEmulator.Controls.SessionCreationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BridgeSystems.Bridgemate.DataConnectorClientEmulator.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <GroupBox Header="Session properties">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource HeaderTextblockStyle}" Text="Session guid:"
                      Margin="4,2,2,2"/>
                    <TextBlock Text="{Binding SessionGuid}"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Scoring groups:" Style="{StaticResource HeaderTextblockStyle}"
                               Margin="4,2,2,2"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding CreatedScoringGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScoringGroupNumber,StringFormat={}{0}:}" Margin="2,2,4,0"/>
                                    <TextBlock Text="{Binding ScoringMethod,
                                                              Converter={StaticResource ScoringTypeConverter},StringFormat={}{0};}"
                                               Margin="4,2,2,2" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </GroupBox>
        <GroupBox Header="Section properties">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Section:"/>
                    <ComboBox ItemsSource="{Binding CreatableSections}"
                              SelectedItem="{Binding SelectedCreatableSection}"/>
                    <TextBlock Text="Pairs:"/>
                    <ComboBox ItemsSource="{Binding CreatableNumberOfPairs}"
                              SelectedItem="{Binding SelectedCreatableNumberOfPairs}"/>
                    <TextBlock Text="Rounds:"/>
                    <ComboBox ItemsSource="{Binding NumberOfRounds}"
                              SelectedItem="{Binding SelectedNumberOfRounds}"/>
                    <TextBlock Text="Boards per round:"/>
                    <ComboBox ItemsSource="{Binding NumberOfBoardsPerRound}"
                     SelectedItem="{Binding SelectedNumberOfBoardsPerRound}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Scoringgroup number:"/>
                    <ComboBox ItemsSource="{Binding ScoringGroupNumbers}"
                     SelectedItem="{Binding SelectedScoringGroupNumber}"/>
                    <TextBlock Text="Scoring method:"/>
                    <ComboBox ItemsSource="{Binding ScoringTypes}" 
                     SelectedItem="{Binding SelectedScoringType ,Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                  Margin="4,2,2,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Game type:"/>
                    <ComboBox ItemsSource="{Binding GameTypes}" 
                     SelectedItem="{Binding SelectedGameType ,Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                  Margin="4,2,2,2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel>
            <GroupBox Header="Movement generation options">
                <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding FixedBoards}" Content="Fixed boards."/>
                    <RadioButton IsChecked="{Binding UseConsecutiveNumbering,Mode=TwoWay}" Content="Consecutive numbering"/>
                    <RadioButton IsChecked="{Binding UseEwOffset,Mode=TwoWay}" Content="Use EW offset:"/>
                    <TextBox Text="{Binding EwOffset}" IsEnabled="{Binding UseEwOffset}" VerticalAlignment="Center"
                        Width="100"/>
                </StackPanel>
            </GroupBox>
            <TextBlock Style="{StaticResource HeaderTextblockStyle}">
           Adds or replaces the section.
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddTwoWinnerSectionCommand}" Content="Add two winners section"
                       MaxWidth="200" ToolTip="{Binding AddTwoWinnerSectionCommandDescription}"/>
                <Button Command="{Binding AddOneWinnerSectionCommand}" Content="Add one winner section (arrowshift in round 2)"
                       MaxWidth="300" ToolTip="{Binding AddOneWinnerSectionCommandDescription}"/>
                <Button Command="{Binding ClearSectionsCommand}" Content="Clear sections (after error)"
                        ToolTip="{Binding ClearSectionsCommandDescription}"/>
            </StackPanel>
            <ScrollViewer Visibility="{Binding HasSectionCreationValidationErrors,
                                               Converter={StaticResource BVP},ConverterParameter=collapse}">
                <ItemsControl ItemsSource="{Binding SectionCreationValidationMessages}"
                             Foreground="Red">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Style="{StaticResource HeaderTextblockStyle}">
               Update the event after it has been launched.
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding AddNewSectionsCommand}" Content="Send updated section(s)"
                        IsEnabled="{Binding HasLaunched}" ToolTip="{Binding AddNewSectionsCommandDesctiption}"/>
                    <TextBlock Text="{Binding AddedSectionDescriptions}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding AddSessionCommand}" Content="Send added session"
                        IsEnabled="{Binding HasLaunched,Converter={StaticResource Not}}" ToolTip="{Binding AddSessionCommandDescription}"/>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding SessionGuid}" Margin="4,2,2,2"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
